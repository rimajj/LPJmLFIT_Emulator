     //printf("NPP(%s)=%g\n",pft->par->name,npp);
     pft->anpp+=npp;
     pft->agpp+=npp;
+    /* The line above adds NPP, not GPP — so `agpp` (and the `ind` output's `gpp` column) is a
+       second copy of NPP. Left untouched. `agpp_gross` accumulates the real thing: the SAME
+       `gpp` that is passed to npp() above and added to the D_GPP/GPP outputs below, so a
