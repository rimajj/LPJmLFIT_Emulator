diff --git a/include/pft.h b/include/pft.h
index a2a74b3..5b32bbf 100644
--- a/include/pft.h
+++ b/include/pft.h
@@ -243,7 +243,18 @@ typedef struct Pft
   Real afpar;
   Real atransp;          /**< annual transpiration (mm/yr) */
   Real anpp;             /**< annual NPP (gC/yr) */
-  Real agpp;             /**< annual NPP (gC/yr) */
+  Real agpp;             /**< annual NPP (gC/yr) -- NOT GPP. daily_natural.c accumulates `npp`
+                              into this field, so the `ind` output's `gpp` column is a second
+                              copy of `npp` (the upstream comment here says NPP too). Left
+                              exactly as-is: committed reference bases are measured against it. */
+  Real agpp_gross;       /**< annual GROSS GPP (gC/yr) -- the `gpp` daily_natural.c passes to
+                              npp() and adds to the D_GPP output, i.e. the per-individual
+                              counterpart of the stand GPP output that LPJmL-FIT otherwise has
+                              nowhere. Diagnostic only; no physics reads it. Reaches the `ind`
+                              output's `gpp` column only when LPJ_IND_TRUE_GPP is set
+                              (fwriteoutput_ind.c), so a run with that variable unset is
+                              byte-identical. Not in fwritepft/freadpft -- like anpp/agpp it is
+                              an annual accumulator, zeroed by init_annual -> init_tree/grass. */
 #ifdef DAILY_ESTABLISHMENT
   Bool established;
 #endif
