+# Learned land emulator bridge in LPJmL (src/land_atlantes/LPJmL/src/landemu_py.c; esm_land_emulator
+# ADR 0347): embedded Python of LANDEMU_PYTHON, switched on at run time by LANDEMU=1.
+# LANDEMU_PYLIB holds ONLY libpython3.11.so(.1.0) (symlinks into the Python environment): putting the
+# environment's own lib/ on the search path makes -lnetcdf/-lhdf5 resolve to ITS shared libraries
+# instead of the static ones POEM uses, and the run aborts in NC4_open (HDF5 version mismatch).
+if ( ! $?LANDEMU_PYLIB ) setenv LANDEMU_PYLIB /p/projects/open/Jamir/poem_landemu/pylib
+set landemu_libs = "-L$LANDEMU_PYLIB -lpython3.11 -Wl,-rpath,$LANDEMU_PYLIB"
+
 # Build the executable
 set mkmf_exec = "$mkmf -f -m Makefile -a $code_dir -t $mkmfTemplate -p $executable:t"
 mkdir -p $executable:h
