@@ -0,0 +1,26 @@
+/**************************************************************************************/
+/**                                                                                \n**/
+/**                l  a  n  d  e  m  u  .  h                                       \n**/
+/**                                                                                \n**/
+/**     Plain-C interface to the embedded learned land emulator (landemu_py.c).    \n**/
+/**     Switched on at run time by LANDEMU=1; otherwise the model is stock POEM.   \n**/
+/**                                                                                \n**/
+/**     Per cell and day the emulator reads LANDEMU_NF forcing columns:            \n**/
+/**       2-m air temperature (degC), precipitation (mm/day), downward shortwave   \n**/
+/**       (W/m2), net longwave (W/m2), 2-m specific humidity (kg/kg)               \n**/
+/**     and returns LANDEMU_NOUT columns, NaN where a cell is not emulated:        \n**/
+/**       evapotranspiration (mm/day), runoff (mm/day), per unit land area.        \n**/
+/**                                                                                \n**/
+/**************************************************************************************/
+
+#ifndef LANDEMU_H
+#define LANDEMU_H
+
+#define LANDEMU_NF 5
+#define LANDEMU_NOUT 2
+
+extern int landemu_py_init(int ncell, const double *lat, const double *lon, int rank, int *mask);
+extern void landemu_py_day(int ncell, const double *F, const double *X, int nx, double *out);
+extern void landemu_py_finish(void);
+
+#endif
