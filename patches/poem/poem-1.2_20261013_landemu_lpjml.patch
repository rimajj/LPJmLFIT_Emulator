@@ -2370,6 +2569,8 @@ void lpj_update_
         } /* of for(cell=0;cell<config.ngridcell;cell++) */
         printf(" temp: %-.2f  prec: %-.3f  albedo: %-.3f  q_ca: %-.3f  \n",temp_mean/(global_area),prec_mean/(global_area),albedo_mean/(global_area),qca_mean/(global_area));
 
