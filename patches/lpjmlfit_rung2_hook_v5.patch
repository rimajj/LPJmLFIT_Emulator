diff --git a/src/lpj/rung2_apply.c b/src/lpj/rung2_apply.c
new file mode 100644
index 0000000..353a08e
--- /dev/null
+++ b/src/lpj/rung2_apply.c
@@ -0,0 +1,419 @@
+/**************************************************************************************/
+/**                                                                                \n**/
+/**            r  u  n  g  2  _  a  p  p  l  y  .  c                               \n**/
+/**                                                                                \n**/
+/**     Opt-in demography SUBSTITUTION hook — see include/rung2apply.h.            \n**/
+/**                                                                                \n**/
+/**     Byte-identity: every entry point returns immediately when the environment  \n**/
+/**     variable LPJ_RUNG2_APPLY_DIR is unset, and nothing here writes to model    \n**/
+/**     state on that path.                                                        \n**/
+/**                                                                                \n**/
+/**************************************************************************************/
+
+#include <time.h>
+#include <unistd.h>
+#include "lpj.h"
+#include "tree.h"
+#include "grass.h"
+#include "rung2hook.h"
+#include "rung2apply.h"
+
+#define R2A "%.17g"
+#define POLL_NS 2000000L        /* 2 ms between polls of the response marker */
+
+/* ------------------------------------------------------------------------- *
+ *  WHY THE KILL IS DEFERRED OUT OF THE GROWTH LOOP (line M, ADR 0123)
+ *
+ *  The rendezvous used to sit at the TOP of the annual block, which made the
+ *  roster it published a year stale in bm_inc_counter: that counter is updated
+ *  from THIS year's bm_delta inside mortality_tree_ind(), i.e. after the
+ *  rendezvous had already happened, and it MULTIPLIES mort_npp and mort_water
+ *  by (1+counter).  Misdating it re-weights exactly the trees a trait-selection
+ *  statistic measures — measured, it inverted the sign of the one-year wood
+ *  density selection differential (+17 729 -> -14 528, ADR 0122).
+ *
+ *  So the rendezvous moves behind the growth loop.  That forces the kill to
+ *  move with it: a tree the external demography spares must not already have
+ *  been put into the litter.  The kills of a patch-year therefore all happen
+ *  after the loop rather than interleaved with the later trees' turnover and
+ *  allocation.
+ *
+ *  That reordering is MATHEMATICALLY inert, which is what lets the null control
+ *  stay exact:
+ *    - the litter pools it feeds are pure sums;
+ *    - litter->avg_fbd is an exact incremental carbon-weighted mean (each
+ *      update_fbd_tree() re-weights by the pool total AFTER its own addition),
+ *      so its value once every contribution is in does not depend on the order;
+ *    - nothing between the loop and the kill pass READS either — fire_prob(),
+ *      firepft() and the FPC/output blocks all run afterwards;
+ *    - litter_update_tree() mutates only the dying tree's own pools, which no
+ *      other tree's turnover or allocation reads.
+ *  It is not bit-identical (floating-point addition is not associative), so the
+ *  deferral is shared by BOTH hooks: the recorded baseline and every replayed
+ *  arm sit on the same code path, and with both env vars unset the stock model
+ *  is untouched.
+ * ------------------------------------------------------------------------- */
+
+typedef struct
+{
+  int pft_id;
+  int treeidx;
+} Killkey;
+
+typedef struct
+{
+  int pft_id;
+  Real sla, wooddens, D95max, minwscal;
+} Recruit;
+
+/* the C's own verdict for one tree of the current patch-year, recorded by
+   rung2_apply_note() during the growth loop and consumed by the kill pass */
+typedef struct
+{
+  int pft_id;
+  int treeidx;
+  Bool c_isdead;
+  Bool hard;
+} Verdict;
+
+static int enabled = -1;        /* -1 = not yet resolved, 0 = off, 1 = on */
+static const char *dir = NULL;
+static int timeout_s = 600;
+static FILE *audit = NULL;
+
+/* state of the current rendezvous */
+static Bool open_patch = FALSE;
+static int cur_year, cur_patch;
+static Killkey *kills = NULL;
+static int nkill = 0, killsize = 0;
+static Recruit *recruits = NULL;
+static int nrecruit = 0, recruitsize = 0;
+/* per-patch-year opt-outs, so one half of the interface can be substituted while
+   the other is left to the C — the only way an arm's effect is attributable */
+static Bool defer_mort = FALSE, defer_estab = FALSE;
+/* the growth loop's verdict table; also the roster key set a K line resolves
+   against, so it grows instead of silently capping the way the fixed 1024-entry
+   array it replaces did */
+static Verdict *verdicts = NULL;
+static int nverdict = 0, verdictsize = 0;
+/* audit counters, reset per patch-year */
+static int n_pre, n_kill_c, n_kill_applied, n_forced_dead, n_spared_certain, n_clamped;
+
+Bool rung2_apply_enabled(void)
+{
+  const char *s;
+  if(enabled < 0)
+  {
+    dir = getenv("LPJ_RUNG2_APPLY_DIR");
+    enabled = (dir != NULL && dir[0] != '\0') ? 1 : 0;
+    s = getenv("LPJ_RUNG2_APPLY_TIMEOUT");
+    if(s != NULL && s[0] != '\0')
+      timeout_s = atoi(s);
+  }
+  return (enabled == 1) ? TRUE : FALSE;
+} /* of 'rung2_apply_enabled' */
+
+Bool rung2_defer_mortality(void)
+{
+  return (rung2_enabled() || rung2_apply_enabled()) ? TRUE : FALSE;
+} /* of 'rung2_defer_mortality' */
+
+void rung2_apply_reset_patch(void)
+{
+  if(!rung2_defer_mortality())
+    return;
+  nverdict = nkill = nrecruit = 0;
+  defer_mort = defer_estab = FALSE;
+  n_pre = n_kill_c = n_kill_applied = n_forced_dead = n_spared_certain = n_clamped = 0;
+} /* of 'rung2_apply_reset_patch' */
+
+static Verdict *find_verdict(const Pft *pft)
+{
+  const Pfttree *tree;
+  int i;
+  tree = pft->data;
+  for(i = 0; i < nverdict; i++)
+    if(verdicts[i].pft_id == pft->par->id && verdicts[i].treeidx == tree->index)
+      return verdicts + i;
+  return NULL;
+} /* of 'find_verdict' */
+
+void rung2_apply_note(const Pft *pft, Bool c_isdead, Bool hard)
+{
+  const Pfttree *tree;
+  if(!rung2_defer_mortality())
+    return;
+  /* the roster key must be unique, or a K line naming it is ambiguous.
+     `index` is a per-PFT counter (new_tree.c), so the key is (pft_id,treeidx) */
+  if(find_verdict(pft) != NULL)
+  {
+    tree = pft->data;
+    fail(OPEN_COUPLER_ERR, FALSE,
+         "rung2 apply: duplicate roster key (pft %d, tree %d)",
+         pft->par->id, tree->index);
+  }
+  if(nverdict == verdictsize)
+  {
+    verdictsize = (verdictsize == 0) ? 64 : verdictsize * 2;
+    verdicts = (Verdict *)realloc(verdicts, sizeof(Verdict) * verdictsize);
+    check(verdicts);
+  }
+  tree = pft->data;
+  verdicts[nverdict].pft_id = pft->par->id;
+  verdicts[nverdict].treeidx = tree->index;
+  verdicts[nverdict].c_isdead = c_isdead;
+  verdicts[nverdict].hard = hard;
+  nverdict++;
+  if(c_isdead)
+    n_kill_c++;
+} /* of 'rung2_apply_note' */
+
+static void keypath(char *buf, size_t n, const char *kind, const char *ext,
+                    int rank, int year, int patch)
+{
+  snprintf(buf, n, "%s/%s_r%04d_y%05d_p%03d.%s", dir, kind, rank, year, patch, ext);
+} /* of 'keypath' */
+
+static void touch(const char *path)
+{
+  FILE *f;
+  f = fopen(path, "w");
+  if(f == NULL)
+    fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: cannot create marker '%s'", path);
+  fclose(f);
+} /* of 'touch' */
+
+void rung2_apply_begin_patch(const Stand *stand, const Patch *patch, int np,
+                             int npft, int year, const Config *config)
+{
+  char req[1024], reqok[1024], rsp[1024], rspok[1024], line[2048], path[1024];
+  FILE *f;
+  int i, waited_ns;
+  struct timespec ts;
+  Killkey k;
+  Recruit r;
+  if(!rung2_apply_enabled())
+    return;
+  if(audit == NULL)
+  {
+    snprintf(path, sizeof(path), "%s/audit_r%04d.txt", dir, config->rank);
+    audit = fopen(path, "w");
+    if(audit == NULL)
+      fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: cannot open '%s'", path);
+    fprintf(audit, "#H A year patch n_pre n_kill_c n_kill_applied n_forced_dead "
+                   "n_spared_certain n_recruit n_clamped sub_mort sub_estab\n");
+  }
+  cur_year = year;
+  cur_patch = np;
+  /* NB: the counters and the verdict table are reset by rung2_apply_reset_patch()
+     at the TOP of the patch-year, not here — the growth loop fills them before
+     this rendezvous opens. */
+  nkill = nrecruit = 0;
+  n_pre = nverdict;
+
+  keypath(req, sizeof(req), "req", "txt", config->rank, year, np);
+  keypath(reqok, sizeof(reqok), "req", "ready", config->rank, year, np);
+  keypath(rsp, sizeof(rsp), "rsp", "txt", config->rank, year, np);
+  keypath(rspok, sizeof(rspok), "rsp", "ready", config->rank, year, np);
+  /* a leftover answer from an earlier run would be read as this run's */
+  unlink(rsp);
+  unlink(rspok);
+
+  /* --- the request: the same roster records the observation hook writes, at
+         the same point as its "grow" phase --- */
+  f = fopen(req, "w");
+  if(f == NULL)
+    fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: cannot open '%s'", req);
+  rung2_write_header(f);
+  rung2_write_patch(f, stand, patch, np, year, "grow", config);
+  fprintf(f, "#END\n");
+  fclose(f);
+  touch(reqok);
+
+  /* --- block until the external demography answers --- */
+  waited_ns = 0;
+  while(access(rspok, F_OK) != 0)
+  {
+    ts.tv_sec = 0;
+    ts.tv_nsec = POLL_NS;
+    nanosleep(&ts, NULL);
+    waited_ns++;
+    if(timeout_s > 0 && (double)waited_ns * POLL_NS / 1e9 > (double)timeout_s)
+      fail(OPEN_COUPLER_ERR, FALSE,
+           "rung2 apply: no answer for year %d patch %d after %d s ('%s')",
+           year, np, timeout_s, rspok);
+  }
+  f = fopen(rsp, "r");
+  if(f == NULL)
+    fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: cannot read '%s'", rsp);
+  while(fgets(line, sizeof(line), f) != NULL)
+  {
+    if(line[0] == '#' || line[0] == '\n')
+      continue;
+    if(line[0] == 'K')
+    {
+      if(sscanf(line + 1, "%d %d", &k.pft_id, &k.treeidx) != 2)
+        fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: bad K line in '%s': %s", rsp, line);
+      for(i = 0; i < nverdict; i++)
+        if(verdicts[i].pft_id == k.pft_id && verdicts[i].treeidx == k.treeidx)
+          break;
+      if(i == nverdict)
+        fail(OPEN_COUPLER_ERR, FALSE,
+             "rung2 apply: K names (pft %d, tree %d), not in the year %d patch %d roster",
+             k.pft_id, k.treeidx, year, np);
+      if(nkill == killsize)
+      {
+        killsize = (killsize == 0) ? 64 : killsize * 2;
+        kills = (Killkey *)realloc(kills, sizeof(Killkey) * killsize);
+        check(kills);
+      }
+      kills[nkill++] = k;
+    }
+    else if(line[0] == 'R')
+    {
+      if(sscanf(line + 1, "%d %lg %lg %lg %lg", &r.pft_id, &r.sla, &r.wooddens,
+                &r.D95max, &r.minwscal) != 5)
+        fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: bad R line in '%s': %s", rsp, line);
+      if(r.pft_id < 0 || r.pft_id >= getnnat(npft, config) ||
+         config->pftpar[r.pft_id].type != TREE)
+        fail(OPEN_COUPLER_ERR, FALSE,
+             "rung2 apply: R names pft %d, which is not a tree", r.pft_id);
+      if(nrecruit == recruitsize)
+      {
+        recruitsize = (recruitsize == 0) ? 64 : recruitsize * 2;
+        recruits = (Recruit *)realloc(recruits, sizeof(Recruit) * recruitsize);
+        check(recruits);
+      }
+      recruits[nrecruit++] = r;
+    }
+    else if(!strncmp(line, "MORT_C", 6))
+      defer_mort = TRUE;     /* leave WHO DIES to the C this patch-year */
+    else if(!strncmp(line, "ESTAB_C", 7))
+      defer_estab = TRUE;    /* leave WHO ESTABLISHES to the C this patch-year */
+    else if(line[0] == 'E')
+      break;
+    else
+      fail(OPEN_COUPLER_ERR, FALSE, "rung2 apply: unknown record in '%s': %s", rsp, line);
+  }
+  fclose(f);
+  unlink(req);
+  unlink(reqok);
+  unlink(rsp);
+  unlink(rspok);
+  open_patch = TRUE;
+} /* of 'rung2_apply_begin_patch' */
+
+Bool rung2_apply_isdead(const Pft *pft)
+{
+  const Pfttree *tree;
+  const Verdict *note;
+  Bool ext_dead;
+  int i;
+  note = find_verdict(pft);
+  if(note == NULL)
+    return FALSE;   /* not seen by the growth loop, so not this pass's business */
+  /* no external demography, or it deferred this half: the C's own answer,
+     applied here instead of inside the loop */
+  if(!rung2_apply_enabled() || !open_patch || defer_mort)
+    return note->c_isdead;
+  tree = pft->data;
+  ext_dead = FALSE;
+  for(i = 0; i < nkill; i++)
+    if(kills[i].pft_id == pft->par->id && kills[i].treeidx == tree->index)
+    {
+      ext_dead = TRUE;
+      break;
+    }
+  if(ext_dead)
+  {
+    n_kill_applied++;
+    return TRUE;
+  }
+  if(note->hard)                /* the C cannot carry this tree forward alive */
+  {
+    n_forced_dead++;
+    return TRUE;
+  }
+  /* the external demography spares a tree the C was certain of: allowed, but it
+     is the clearest measure of how far the substitution departs from the C */
+  if(note->c_isdead && tree->mort_prob >= 1.0)
+    n_spared_certain++;
+  return FALSE;
+} /* of 'rung2_apply_isdead' */
+
+int rung2_apply_nrecruit(void)
+{
+  if(!rung2_apply_enabled() || !open_patch)
+    return 0;
+  if(defer_estab)
+    return -1;   /* the caller runs the C's own establishment instead */
+  return nrecruit;
+} /* of 'rung2_apply_nrecruit' */
+
+Bool rung2_apply_recruit(int i, int *pft_id, Real *sla, Real *wooddens,
+                         Real *D95max, Real *minwscal)
+{
+  if(!rung2_apply_enabled() || !open_patch || i < 0 || i >= nrecruit)
+    return FALSE;
+  *pft_id = recruits[i].pft_id;
+  *sla = recruits[i].sla;
+  *wooddens = recruits[i].wooddens;
+  *D95max = recruits[i].D95max;
+  *minwscal = recruits[i].minwscal;
+  return TRUE;
+} /* of 'rung2_apply_recruit' */
+
+/* NB: do NOT name a local `v` in this tree — include/discharge.h does
+   `#define v 86400.0`, so the compiler sees a numeric literal. */
+static Real clamp_trait(Real val, Real lo, Real hi, int *counter)
+{
+  if(lo > hi)                   /* no interval given */
+    return val;
+  if(val < lo)
+  {
+    (*counter)++;
+    return lo;
+  }
+  if(val > hi)
+  {
+    (*counter)++;
+    return hi;
+  }
+  return val;
+} /* of 'clamp_trait' */
+
+void rung2_apply_set_traits(Pft *pft, Real sla, Real wooddens, Real D95max,
+                            Real minwscal)
+{
+  Pfttree *tree;
+  const Pfttreepar *treepar;
+  if(!rung2_apply_enabled())
+    return;
+  tree = pft->data;
+  treepar = pft->par->data;
+  pft->sla = clamp_trait(sla, pft->par->sla.low, pft->par->sla.high, &n_clamped);
+  pft->minwscal = clamp_trait(minwscal, pft->par->minwscal.low,
+                              pft->par->minwscal.high, &n_clamped);
+  tree->wooddens = clamp_trait(wooddens, treepar->wooddens.low,
+                               treepar->wooddens.high, &n_clamped);
+  tree->D95max = clamp_trait(D95max, treepar->D95max.low, treepar->D95max.high,
+                             &n_clamped);
+  /* what new_tree.c derives from the two traits we just replaced */
+  pft->beta_root = getbetaroot(layerbound[BOTTOMLAYER - 1] * 0.1, tree->D95max);
+  pft->longevity = corr_corridor(pft->sla, pft->par->longevity.interc,
+                                 pft->par->longevity.slope,
+                                 pft->par->longevity.sigma,
+                                 pft->patch->stand->cell->seed);
+} /* of 'rung2_apply_set_traits' */
+
+void rung2_apply_end_patch(void)
+{
+  if(!rung2_apply_enabled() || !open_patch)
+    return;
+  fprintf(audit, "A %d %d %d %d %d %d %d %d %d %d %d\n", cur_year, cur_patch,
+          n_pre, n_kill_c, n_kill_applied, n_forced_dead, n_spared_certain,
+          defer_estab ? -1 : nrecruit, n_clamped,
+          defer_mort ? 0 : 1, defer_estab ? 0 : 1);
+  fflush(audit);
+  open_patch = FALSE;
+} /* of 'rung2_apply_end_patch' */
diff --git a/src/lpj/rung2_hook.c b/src/lpj/rung2_hook.c
new file mode 100644
index 0000000..9238402
--- /dev/null
+++ b/src/lpj/rung2_hook.c
@@ -0,0 +1,185 @@
+/**************************************************************************************/
+/**                                                                                \n**/
+/**                r  u  n  g  2  _  h  o  o  k  .  c                              \n**/
+/**                                                                                \n**/
+/**     Opt-in demography observation hook — see include/rung2hook.h.              \n**/
+/**                                                                                \n**/
+/**     Purpose: expose, at the exact point LPJmL-FIT decides who dies and who     \n**/
+/**     establishes, the complete per-tree state and the accumulators the four     \n**/
+/**     death rates read, so an external demography can be scored against — and    \n**/
+/**     later substituted for — the C's own answer.                                \n**/
+/**                                                                                \n**/
+/**     Byte-identity: every entry point returns immediately when the environment  \n**/
+/**     variable LPJ_RUNG2_DIR is unset, and nothing here writes to model state.   \n**/
+/**                                                                                \n**/
+/**************************************************************************************/
+
+#include "lpj.h"
+#include "tree.h"
+#include "grass.h"
+#include "rung2hook.h"
+
+#define R2 "%.17g"
+
+static int enabled = -1;   /* -1 = not yet resolved, 0 = off, 1 = on */
+static const char *dir = NULL;
+static FILE *out = NULL;
+
+Bool rung2_enabled(void)
+{
+  if(enabled < 0)
+  {
+    dir = getenv("LPJ_RUNG2_DIR");
+    enabled = (dir != NULL && dir[0] != '\0') ? 1 : 0;
+  }
+  return (enabled == 1) ? TRUE : FALSE;
+} /* of 'rung2_enabled' */
+
+void rung2_write_header(FILE *out)
+{
+  /* Column headers, one per record kind.  Written once per file so a reader
+     never has to carry a hard-coded schema. */
+  fprintf(out,
+          "#H P phase lon lat year patch npatch patcharea fpar_leafon_grass "
+          "treelen ntree_alive aprec "
+          "seed gasdev_iset sb_agb sb_trait sb_year sb_id\n");
+  fprintf(out,
+          "#H T phase lon lat year patch treeidx pft_id age "
+          "sla wooddens D95max minwscal k_root emax beta_root beta_2 leaf_longevity "
+          "height crownarea boleht nind fpc fapar afpar "
+          "leaf_c sapwood_c heartwood_c root_c sapwood_bg_c heartwood_bg_c debt_c "
+          "bm_inc_c anpp agpp atransp wscal_mean water_stress temp_stress "
+          "bm_inc_counter gddtw aphen_raingreen sapwood_old leaf_old "
+          "isdead mort_prob mort_npp mort_age mort_water mort_temp "
+          "bm_delta leafarea_real\n");
+  fprintf(out,
+          "#H G phase lon lat year patch pft_id fpc nind bm_inc_c anpp agpp\n");
+} /* of 'rung2_write_header' */
+
+static FILE *rung2_file(const Config *config)
+{
+  char path[1024];
+  if(out != NULL)
+    return out;
+  snprintf(path, sizeof(path), "%s/roster_rank%04d.txt", dir, config->rank);
+  out = fopen(path, "w");
+  if(out == NULL)
+    fail(OPEN_COUPLER_ERR, FALSE, "rung2: cannot open '%s' for writing", path);
+  rung2_write_header(out);
+  return out;
+} /* of 'rung2_file' */
+
+void rung2_write_patch(FILE *f, const Stand *stand, const Patch *patch, int np,
+                       int year, const char *phase, const Config *config)
+{
+  const Pft *pft;
+  const Pfttree *tree;
+  const Sapling *sap;
+  int p, i, ntree_alive, sb_year, sb_id;
+  Real lon, lat, sb_agb, sb_trait;
+  char seedstr[64], *s;
+  lon = stand->cell->coord.lon;
+  lat = stand->cell->coord.lat;
+
+  ntree_alive = 0;
+  foreachpft(pft, p, &patch->pftlist)
+    if(istree(pft))
+    {
+      tree = pft->data;
+      if(!tree->isdead)
+        ntree_alive++;
+    }
+
+  /* CELL-LEVEL state the per-tree records cannot carry, and the reason this is
+     here: two runs can agree in every dumped tree column and still take a
+     different demographic decision the next year, because the decision also
+     reads (a) the per-cell RAND48 stream, (b) gasdev()'s process-global pair
+     cache, and (c) the rolling top-AGB seedbank cell->treelist, which
+     inheritance draws recruits from (new_tree.c:130) and which is rebuilt
+     yearly.  Only `treelen` was previously dumped, so a seedbank whose LENGTH
+     matched but whose CONTENTS had moved was indistinguishable from agreement.
+     sb_* are order-independent checksums, not the list itself: enough to prove
+     a difference, cheap enough to write every patch-year.
+
+     Deliberately NOT dumped: cell->treelen_old / treelist_old.  Their only
+     writer is getsapling.c:57-58, behind `if(config->isequal)`, and isequalcoord
+     returns TRUE only when every cell in the run shares identical coordinates
+     (and is hardwired FALSE for nall==1) — so the branch is dead in every real
+     run, mergesapling() has no caller anywhere in src/, and the field is
+     uninitialised memory.  Dumping it would ship a third garbage column of
+     exactly the kind ADR 0120 had to withdraw. */
+  s = seedstr;
+  for(i = 0; i < NSEED; i++)
+    s += snprintf(s, sizeof(seedstr) - (size_t)(s - seedstr),
+                  (i == 0) ? "%04x" : ":%04x", (unsigned)stand->cell->seed[i]);
+
+  sb_agb = sb_trait = 0.0;
+  sb_year = sb_id = 0;
+  for(i = 0; i < stand->cell->treelen; i++)
+  {
+    sap = stand->cell->treelist + i;
+    sb_agb += sap->agb;
+    sb_trait += sap->sla + sap->wooddens + sap->D95max + sap->minwscal
+                + sap->emax + sap->k_root + sap->beta_root + sap->beta_2
+                + sap->fpc;
+    sb_year += sap->year;
+    sb_id += sap->id;
+  }
+
+  fprintf(f, "P %s " R2 " " R2 " %d %d %d " R2 " " R2 " %d %d " R2 " "
+             "%s %d " R2 " " R2 " %d %d\n",
+          phase, lon, lat, year, np, stand->npatch, param.patcharea,
+          patch->fpar_leafon_grass, stand->cell->treelen, ntree_alive,
+          stand->cell->balance.aprec,
+          seedstr, gasdev_iset(),
+          sb_agb, sb_trait, sb_year, sb_id);
+
+  foreachpft(pft, p, &patch->pftlist)
+  {
+    if(istree(pft))
+    {
+      tree = pft->data;
+      fprintf(f,
+              "T %s " R2 " " R2 " %d %d %d %d %d "
+              R2 " " R2 " " R2 " " R2 " " R2 " " R2 " " R2 " " R2 " " R2 " "
+              R2 " " R2 " " R2 " " R2 " " R2 " " R2 " " R2 " "
+              R2 " " R2 " " R2 " " R2 " " R2 " " R2 " " R2 " "
+              R2 " " R2 " " R2 " " R2 " " R2 " " R2 " %d "
+              "%d " R2 " " R2 " " R2 " " R2 " "
+              "%d " R2 " " R2 " " R2 " " R2 " " R2 " "
+              R2 " " R2 "\n",
+              phase, lon, lat, year, np, tree->index, pft->par->id, tree->age,
+              pft->sla, tree->wooddens, tree->D95max, pft->minwscal,
+              tree->k_root, pft->emax, pft->beta_root, pft->beta_2,
+              pft->longevity,
+              tree->height, tree->crownarea, tree->boleht, pft->nind, pft->fpc,
+              pft->fapar, pft->afpar,
+              tree->ind.leaf.carbon, tree->ind.sapwood.carbon,
+              tree->ind.heartwood.carbon, tree->ind.root.carbon,
+              tree->ind.sapwood_bg.carbon, tree->ind.heartwood_bg.carbon,
+              tree->ind.debt.carbon,
+              pft->bm_inc.carbon, pft->anpp, pft->agpp, pft->atransp,
+              pft->wscal_mean, tree->water_stress, tree->temp_stress,
+              tree->bm_inc_counter, tree->gddtw, tree->aphen_raingreen,
+              tree->sapwood_old, tree->leaf_old,
+              (int)tree->isdead, tree->mort_prob, tree->mort_npp,
+              tree->mort_age, tree->mort_water, tree->mort_temp,
+              tree->bm_delta, tree->leafarea_real);
+    }
+    else
+      fprintf(f, "G %s " R2 " " R2 " %d %d %d " R2 " " R2 " " R2 " " R2 " " R2 "\n",
+              phase, lon, lat, year, np, pft->par->id, pft->fpc, pft->nind,
+              pft->bm_inc.carbon, pft->anpp, pft->agpp);
+  }
+} /* of 'rung2_write_patch' */
+
+void rung2_dump_patch(const Stand *stand, const Patch *patch, int np, int year,
+                      const char *phase, const Config *config)
+{
+  FILE *f;
+  if(!rung2_enabled())
+    return;
+  f = rung2_file(config);
+  rung2_write_patch(f, stand, patch, np, year, phase, config);
+  fflush(f);
+} /* of 'rung2_dump_patch' */
