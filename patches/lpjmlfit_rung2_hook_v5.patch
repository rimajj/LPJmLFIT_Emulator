diff --git a/include/rung2apply.h b/include/rung2apply.h
new file mode 100644
index 0000000..22a4fff
--- /dev/null
+++ b/include/rung2apply.h
@@ -0,0 +1,102 @@
+/**************************************************************************************/
+/**                                                                                \n**/
+/**              r  u  n  g  2  a  p  p  l  y  .  h                                \n**/
+/**                                                                                \n**/
+/**     Opt-in demography SUBSTITUTION hook — the read-back half of the            \n**/
+/**     LPJmL-FIT emulator's rung-2 experiment (the observation half is            \n**/
+/**     include/rung2hook.h).  Narrow interface by design: it replaces only        \n**/
+/**     WHO DIES and WHO ESTABLISHES.  Turnover, allocation and growth stay        \n**/
+/**     with the C, which is what keeps the per-tree accumulators the death        \n**/
+/**     rates read (water_stress, temp_stress, bm_inc_counter) intact.             \n**/
+/**                                                                                \n**/
+/**     NOT part of stock LPJmL-FIT.  Activated only when the environment          \n**/
+/**     variable LPJ_RUNG2_APPLY_DIR is set; with it unset every entry point       \n**/
+/**     below returns immediately and the model is byte-identical to stock.        \n**/
+/**                                                                                \n**/
+/**     Protocol (one rendezvous per patch-year, files + spin-wait):               \n**/
+/**       C   writes <dir>/req_r<rank>_y<year>_p<patch>.txt   (the `grow` roster,  \n**/
+/**           i.e. AFTER this year's turnover/allocation/hazard, so the tree       \n**/
+/**           state it carries is current and not a year stale)                    \n**/
+/**           then renames a marker to  ...req_...ready                            \n**/
+/**       C   blocks until                ...rsp_...ready     appears              \n**/
+/**       C   reads  <dir>/rsp_r<rank>_y<year>_p<patch>.txt:                       \n**/
+/**             K <pft_id> <treeidx>                one tree to kill               \n**/
+/**             R <pft_id> <sla> <wooddens> <D95max> <minwscal>   one recruit      \n**/
+/**             END                                                               \n**/
+/**           Any tree of the `pre` roster NOT named by a K line is intended to    \n**/
+/**           live; the R lines are the COMPLETE tree recruit set for the          \n**/
+/**           patch-year (none = no establishment).  '#' starts a comment.         \n**/
+/**                                                                                \n**/
+/**     What the substitution does NOT control, and why the arm must say so:       \n**/
+/**       - a kill the C's own state cannot un-make (negative or exhausted         \n**/
+/**         carbon pools, the logging cut year, bioclimatic limits exceeded)       \n**/
+/**         is honoured over a "live" verdict, and counted in the audit file;      \n**/
+/**       - a recruit carries SEVEN sampled trait axes in this model               \n**/
+/**         (sla, wooddens, D95max, minwscal, emax, k_root, beta_2) plus a         \n**/
+/**         leaf longevity derived from sla.  Only the four named on the R line    \n**/
+/**         are substituted; emax, k_root and beta_2 keep the C's own uniform      \n**/
+/**         draw.  beta_root and longevity are RE-derived from the substituted     \n**/
+/**         D95max and sla, because the C derives them that way in new_tree.       \n**/
+/**                                                                                \n**/
+/**************************************************************************************/
+
+#ifndef RUNG2APPLY_H
+#define RUNG2APPLY_H
+
+/* TRUE when LPJ_RUNG2_APPLY_DIR is set (resolved once, cached). */
+extern Bool rung2_apply_enabled(void);
+
+/* TRUE when EITHER rung-2 hook is on (observation or substitution).  While it
+   is TRUE the demographic kill of a tree is DEFERRED out of the growth loop:
+   annual_tree() computes the hazard and draws as usual but reports the tree
+   alive, and annual_natural() applies the verdicts in one pass after the loop
+   (see the deferral note in rung2_apply.c for why the two orders agree).  Both
+   hooks must share the deferral, or the recorded baseline and the replayed run
+   would sit on different code paths and no null control could be exact. */
+extern Bool rung2_defer_mortality(void);
+
+/* Start one patch-year: clear the per-tree verdict table and the audit
+   counters.  Call at the top of the demography block, before the growth loop.
+   A no-op unless rung2_defer_mortality(). */
+extern void rung2_apply_reset_patch(void);
+
+/* Record the C's own verdict for one tree, from inside the growth loop.
+   `c_isdead` is the C's answer; `hard` says the C cannot represent this tree as
+   alive (negative/exhausted pools, the logging cut year, bioclimatic limits),
+   in which case the C wins over any external verdict. */
+extern void rung2_apply_note(const Pft *pft, Bool c_isdead, Bool hard);
+
+/* Open the rendezvous for one patch-year: write the post-growth roster as a
+   request, block until the external demography answers, and cache the answer
+   for the queries below.  Call AFTER the growth loop, on the same state the
+   "grow" dump sees — that is the only point at which the roster carries the
+   current year's bm_delta / leafarea_real / bm_inc_counter, which are the
+   inputs of mort_npp and hence the whole trait channel of the hazard (ADR
+   0122).  A no-op unless rung2_apply_enabled(). */
+extern void rung2_apply_begin_patch(const Stand *stand, const Patch *patch,
+                                    int np, int npft, int year,
+                                    const Config *config);
+
+/* Final verdict for one tree, queried in the kill pass after the rendezvous.
+   Falls back to the verdict rung2_apply_note() recorded whenever the external
+   demography is absent or defers (MORT_C). */
+extern Bool rung2_apply_isdead(const Pft *pft);
+
+/* Number of tree recruits the external demography asked for in this
+   patch-year (0 if it asked for none). */
+extern int rung2_apply_nrecruit(void);
+
+/* Traits of the i-th recruit.  Returns FALSE if i is out of range. */
+extern Bool rung2_apply_recruit(int i, int *pft_id, Real *sla, Real *wooddens,
+                                Real *D95max, Real *minwscal);
+
+/* Stamp the substituted traits onto a freshly addpft()'ed recruit and re-derive
+   what the C derives from them (beta_root from D95max, leaf longevity from
+   sla).  Values outside the PFT's own interval are clamped and counted. */
+extern void rung2_apply_set_traits(Pft *pft, Real sla, Real wooddens,
+                                   Real D95max, Real minwscal);
+
+/* Close the rendezvous and append this patch-year's audit line. */
+extern void rung2_apply_end_patch(void);
+
+#endif
diff --git a/include/rung2hook.h b/include/rung2hook.h
new file mode 100644
index 0000000..986ab55
--- /dev/null
+++ b/include/rung2hook.h
@@ -0,0 +1,47 @@
+/**************************************************************************************/
+/**                                                                                \n**/
+/**                r  u  n  g  2  h  o  o  k  .  h                                 \n**/
+/**                                                                                \n**/
+/**     Opt-in demography observation hook for the LPJmL-FIT emulator's            \n**/
+/**     error-attribution ladder (rung 2: replace only who dies and who            \n**/
+/**     establishes, leave turnover/allocation/growth to the C).                   \n**/
+/**                                                                                \n**/
+/**     NOT part of stock LPJmL-FIT. Activated only when the environment           \n**/
+/**     variable LPJ_RUNG2_DIR is set; with it unset every entry point below       \n**/
+/**     returns immediately and the model is byte-identical to the stock build.    \n**/
+/**                                                                                \n**/
+/**************************************************************************************/
+
+#ifndef RUNG2HOOK_H
+#define RUNG2HOOK_H
+
+/* TRUE when LPJ_RUNG2_DIR is set (resolved once, cached). */
+extern Bool rung2_enabled(void);
+
+/* Dump one patch's tree roster.  `phase` is "pre" (top of the demography
+   block, before turnover/allocation/mortality) or "post" (after
+   establishment, i.e. the C's own answer for that year).  A no-op unless
+   rung2_enabled(). */
+extern void rung2_dump_patch(const Stand *stand, const Patch *patch, int np,
+                             int year, const char *phase, const Config *config);
+
+/* The two writers rung2_dump_patch is built from, exposed so the substitution
+   half (include/rung2apply.h) puts the IDENTICAL roster format into its
+   per-patch-year request file instead of carrying a second copy of the schema.
+   Both write to an already-open stream and ignore the env var. */
+extern void rung2_write_header(FILE *f);
+extern void rung2_write_patch(FILE *f, const Stand *stand, const Patch *patch,
+                              int np, int year, const char *phase,
+                              const Config *config);
+
+/* Parity of gasdev()'s PROCESS-GLOBAL spare-deviate cache (src/numeric/gasdev.c).
+   gasdev() generates normal deviates in pairs and returns the second from a
+   file-local static on the next call, so the cache parity is cell-independent
+   hidden state that no per-tree or per-cell record can carry: two runs whose
+   model state agrees exactly still draw different normals if an odd number of
+   gasdev() calls separates them.  Read-only; defined in gasdev.c so the static
+   stays file-local.  Declared here rather than in numeric.h to keep the stock
+   headers untouched by this hook. */
+extern int gasdev_iset(void);
+
+#endif
