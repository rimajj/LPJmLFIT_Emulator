@@ -132,6 +132,16 @@ typedef struct
   Real mort_npp;                    /**< npp dependent mortality > */
   Real mort_water;                  /**< water dependent mortality > */
   Real mort_temp;                   /**< temperature dependent mortality > */
+  /* rung-2 demography interface (line M, ADR 0122): the two inputs of mort_npp that no
+     other dumped column carries.  WRITE-ONLY as far as LPJmL's own physics is concerned —
+     set in mortality_tree_ind() and read only by the rung-2 observation hook, so the
