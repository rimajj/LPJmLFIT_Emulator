+static Bool ind_all_heights(void)
+{
+  static int cached=-1;
+  if(cached<0)
+  {
+    const char *env=getenv("LPJ_IND_ALL_HEIGHTS");
+    cached=(env!=NULL && *env!='\0' && strcmp(env,"0")!=0);
+  }
+  return cached ? TRUE : FALSE;
